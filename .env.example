# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (For cloud deployment & database synchronization)
# Found in your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SMS / OTP PROVIDER CONFIGURATION (Optional - for real phone OTP PIN recovery)
# Supported providers: SSL_WIRELESS, GREENWEB, TWILIO, INFOBIP
SMS_PROVIDER="SSL_WIRELESS"
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="MOSAFA_POS"

